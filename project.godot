; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Incremental Lander"
config/description="Incremental estilo Lunar Lander, visao lateral. Ver docs/GDD.md."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/ui/icon_512.png"
config/version="0.9.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="IncrementalLander"
boot_splash/bg_color=Color(0.180392, 0.133333, 0.184314, 1)

[autoload]

Events="*res://autoload/events.gd"
GameState="*res://autoload/game_state.gd"
Telemetry="*res://autoload/telemetry.gd"
SaveManager="*res://autoload/save_manager.gd"
Sound="*res://autoload/sound.gd"
Crt="*res://autoload/crt.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
