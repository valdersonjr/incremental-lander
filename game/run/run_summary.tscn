[gd_scene format=3]

[ext_resource type="Script" path="res://game/run/run_summary.gd" id="1_sum"]

[node name="RunSummary" type="PanelContainer"]
offset_left = 210.0
offset_top = 96.0
offset_right = 430.0
offset_bottom = 250.0
script = ExtResource("1_sum")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "FIM DO RUN"
horizontal_alignment = 1

[node name="Reason" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="Continue" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "NOVO RUN  [Enter]"
