[gd_scene format=3]

[ext_resource type="Script" path="res://game/pause/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.180392, 0.133333, 0.184314, 0.6)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "PAUSA"
horizontal_alignment = 1

[node name="Columns" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Left" type="VBoxContainer" parent="Center/Panel/VBox/Columns"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
theme_override_constants/separation = 3

[node name="Right" type="VBoxContainer" parent="Center/Panel/VBox/Columns"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
theme_override_constants/separation = 3

[node name="VolumeTitle" type="Label" parent="Center/Panel/VBox/Columns/Left"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "SOM E IMAGEM"

[node name="Volumes" type="VBoxContainer" parent="Center/Panel/VBox/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="ControlsTitle" type="Label" parent="Center/Panel/VBox/Columns/Right"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "CONTROLES"

[node name="Keys" type="VBoxContainer" parent="Center/Panel/VBox/Columns/Right"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 1

[node name="Controls" type="VBoxContainer" parent="Center/Panel/VBox/Columns/Right"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="RestoreKeys" type="Button" parent="Center/Panel/VBox/Columns/Right"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
tooltip_text = "volta as teclas ao padrão"
text = "Teclas padrão"

[node name="GameTitle" type="Label" parent="Center/Panel/VBox/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "JOGO"

[node name="Game" type="VBoxContainer" parent="Center/Panel/VBox/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="MenuRow" type="HBoxContainer" parent="Center/Panel/VBox/Columns/Left/Game"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="MenuLabel" type="Label" parent="Center/Panel/VBox/Columns/Left/Game/MenuRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Voltar ao menu inicial (salva)"

[node name="MenuButton" type="Button" parent="Center/Panel/VBox/Columns/Left/Game/MenuRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 15)
layout_mode = 2
