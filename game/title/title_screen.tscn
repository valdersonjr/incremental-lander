[gd_scene format=3]

[ext_resource type="Script" path="res://game/title/title_screen.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://game/title/title_backdrop.tscn" id="2_backdrop"]
[ext_resource type="Texture2D" path="res://assets/ui/logo.png" id="3_logo"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_title")

[node name="Backdrop" parent="." instance=ExtResource("2_backdrop")]
layout_mode = 1

[node name="Logo" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 22.0
offset_top = 18.0
offset_right = 186.0
offset_bottom = 84.0
mouse_filter = 2
texture = ExtResource("3_logo")

[node name="Tagline" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 30.0
offset_top = 88.0
offset_right = 300.0
offset_bottom = 100.0
theme_override_colors/font_color = Color(0.992157, 0.796078, 0.690196, 1)
theme_override_colors/font_shadow_color = Color(0.458824, 0.235294, 0.329412, 1)
text = "Pouse. Entregue. Evolua sua nave."

[node name="Menu" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 30.0
offset_top = 114.0
offset_right = 170.0
offset_bottom = 254.0
theme_override_constants/separation = 6

[node name="Play" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 28)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
theme_override_font_sizes/font_size = 22
text = "Jogar"

[node name="PlayGap" type="Control" parent="Menu"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
mouse_filter = 2

[node name="Warning" type="Label" parent="Menu"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_type_variation = &"BadLabel"
autowrap_mode = 3

[node name="SandboxButton" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 22)
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "teste tudo sem a progressão (nada é salvo)"
text = "Sandbox"

[node name="OptionsButton" type="Button" parent="Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 22)
layout_mode = 2
size_flags_horizontal = 0
text = "Opções"

[node name="Quit" type="Button" parent="Menu"]
unique_name_in_owner = true
