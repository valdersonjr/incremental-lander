[gd_scene format=3]

[ext_resource type="Script" path="res://game/title/title_screen.gd" id="1_title"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_title")

[node name="Logo" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 0.0
offset_top = 34.0
offset_right = 640.0
offset_bottom = 100.0
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Logo"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_shadow_color = Color(0.180392, 0.133333, 0.184314, 1)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 33
text = "INCREMENTAL LANDER"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Logo"]
layout_mode = 2
theme_type_variation = &"ValueLabel"
theme_override_colors/font_shadow_color = Color(0.180392, 0.133333, 0.184314, 1)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 1
text = "pouse, entregue, evolua"
horizontal_alignment = 1

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -90.0
offset_top = 116.0
offset_right = 90.0
offset_bottom = 116.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Menu" type="VBoxContainer" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Play" type="Button" parent="Panel/VBox/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Jogar"

[node name="Info" type="HBoxContainer" parent="Panel/VBox/Menu"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 8

[node name="NewGame" type="Button" parent="Panel/VBox/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Novo jogo"

[node name="OptionsButton" type="Button" parent="Panel/VBox/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Opções"

[node name="Quit" type="Button" parent="Panel/VBox/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Sair"

[node name="Options" type="VBoxContainer" parent="Panel/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 4

[node name="OptionsTitle" type="Label" parent="Panel/VBox/Options"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "OPÇÕES"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "setas: escolher  ·  Enter: confirmar"
horizontal_alignment = 1
