anchor_left = 0.5
anchor_right = 0.5
offset_left = -90.0
offset_top = 116.0
offset_right = 90.0
offset_bottom = 116.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Options" type="VBoxContainer" parent="Panel/VBox"]
